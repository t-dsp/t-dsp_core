		(property "Description" "3-to-8 decoder used as the SAI2 bus interlock: exactly one driver group is enabled at a time. A1:A0 = SAI2_MODE1:SAI2_MODE0 (Teensy T27/T26, 10 k pull-ups): 00 = internal mux U19 (Y0 = SAI2_nOE_INT), 01 = header master U21 group 1 + U20 gate 1 (Y1 = SAI2_nOE_HDR), 10 = Teensy master U21 group 2 + U20 gate 2 (Y2 = SAI2_nOE_OUT), 11 = all off (power-on default). A2, E1, E2 grounded, E3 high."
			(at 0 0 0)
			(layer "F.Fab")
			(hide yes)
			(uuid "a3bf975d-919d-4091-9455-d5d633c911fc")
